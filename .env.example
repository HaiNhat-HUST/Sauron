# =====================================================================
# ai-threat-intel — connector configuration TEMPLATE
# Copy to `.env` and fill in the secrets. `.env` is gitignored; this file
# is the committed template and must NOT contain real keys.
# Every key is optional; connectors missing a required key stay idle.
# =====================================================================

# ---------------------------------------------------------------------
# Global connector defaults (can be overridden per connector below)
# ---------------------------------------------------------------------
# Where connector output (CollectionResult JSON) is written for file output.
CONNECTOR_OUTPUT_DIR=./data/output
# Where each connector persists its run state (cursors, last-run time).
CONNECTOR_STATE_DIR=./data/state
# Log level: DEBUG|INFO|WARNING|ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# abuse.ch — shared Auth-Key (since 2024 ALL abuse.ch APIs require it).
# Also reused by the IOC hash enricher (MalwareBazaar lookups).
# Create a free account + key at https://auth.abuse.ch/
# ---------------------------------------------------------------------
ABUSECH_AUTH_KEY=

# URLhaus (malicious URLs / payload domains)
URLHAUS_ENABLED=true
URLHAUS_INTERVAL_SECONDS=900

# MalwareBazaar (malware sample hashes)
MALWAREBAZAAR_ENABLED=true
MALWAREBAZAAR_INTERVAL_SECONDS=900

# ThreatFox (mixed IOCs: ip:port, domain, url, hash)
THREATFOX_ENABLED=true
THREATFOX_INTERVAL_SECONDS=3600
THREATFOX_DAYS=1

# Feodo Tracker (botnet C2 IPs)
FEODO_ENABLED=true
FEODO_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------
# NVD — CVE feed. API key optional but strongly recommended
# (raises rate limit from 5 to 50 requests / 30s). Request one at
# https://nvd.nist.gov/developers/request-an-api-key
# ---------------------------------------------------------------------
NVD_ENABLED=true
NVD_INTERVAL_SECONDS=3600
NVD_API_KEY=
# How far back to look on the very first run (hours).
NVD_INITIAL_LOOKBACK_HOURS=24

# ---------------------------------------------------------------------
# MITRE ATT&CK — Enterprise matrix (already STIX 2.1). No key needed.
# Refreshed infrequently; daily is plenty.
# ---------------------------------------------------------------------
MITRE_ATTACK_ENABLED=true
MITRE_ATTACK_INTERVAL_SECONDS=86400
MITRE_ATTACK_DOMAIN=enterprise-attack

# ---------------------------------------------------------------------
# CISA KEV — Known Exploited Vulnerabilities catalog. No key needed.
# ---------------------------------------------------------------------
CISA_KEV_ENABLED=true
CISA_KEV_INTERVAL_SECONDS=21600

# ---------------------------------------------------------------------
# AlienVault OTX — subscribed pulses. Requires an API key (free).
# Find it at https://otx.alienvault.com/api
# ---------------------------------------------------------------------
OTX_ENABLED=true
OTX_INTERVAL_SECONDS=3600
OTX_API_KEY=

# ---------------------------------------------------------------------
# Reddit — security subreddits. Without credentials it falls back to
# the public .json endpoints (heavily rate-limited). For production
# create a "script" app at https://www.reddit.com/prefs/apps
# ---------------------------------------------------------------------
REDDIT_ENABLED=true
REDDIT_INTERVAL_SECONDS=1800
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ai-threat-intel/0.1 by your_reddit_user
# Comma-separated subreddits to monitor.
REDDIT_SUBREDDITS=netsec,Malware,blueteamsec,cybersecurity

# ---------------------------------------------------------------------
# RSS — security blogs / advisories. Comma-separated feed URLs.
# Mix: news (BleepingComputer, Krebs, THN, DarkReading, The Record), vendor
# research (Mandiant, Unit 42, MS Security, ESET, Kaspersky, Check Point,
# SentinelLabs), and curated commentary (Schneier, SANS ISC).
# ---------------------------------------------------------------------
RSS_ENABLED=true
RSS_INTERVAL_SECONDS=1800
RSS_FEEDS=https://www.bleepingcomputer.com/feed/,https://krebsonsecurity.com/feed/,https://thehackernews.com/feeds/posts/default,https://www.darkreading.com/rss.xml,https://therecord.media/feed,https://unit42.paloaltonetworks.com/feed/,https://www.microsoft.com/en-us/security/blog/feed/,https://www.mandiant.com/resources/blog/rss.xml,https://www.welivesecurity.com/feed/,https://securelist.com/feed/,https://research.checkpoint.com/feed/,https://isc.sans.edu/rssfeed.xml,https://www.sentinelone.com/labs/feed/,https://www.schneier.com/feed/atom/

# ---------------------------------------------------------------------
# X / Twitter — DISABLED by default. Requires a paid X API v2 bearer
# token. See src/collectors/sources/twitter.py for details.
# ---------------------------------------------------------------------
TWITTER_ENABLED=false
TWITTER_INTERVAL_SECONDS=1800
TWITTER_BEARER_TOKEN=
TWITTER_QUERY=(malware OR ransomware OR CVE) -is:retweet lang:en

# =====================================================================
# Storage — PostgreSQL (simple relational schema: articles/iocs/cves/tags)
# =====================================================================
# Full async SQLAlchemy URL. If set, it takes priority over the discrete
# POSTGRES_* vars below. Driver MUST be psycopg (psycopg3).
DATABASE_URL=postgresql+psycopg://threatintel:threatintel@localhost:5432/threatintel
# Discrete parts (used to build the URL when DATABASE_URL is empty).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=threatintel
POSTGRES_USER=threatintel
POSTGRES_PASSWORD=threatintel
# Echo SQL to logs (debug only).
DB_ECHO=false

# =====================================================================
# Vector database — ChromaDB (article-content embeddings for contextual search)
# =====================================================================
VECTOR_ENABLED=true
# If CHROMA_HOST is set, use a Chroma server; otherwise an embedded persistent
# client at CHROMA_PATH (good for single-process / local dev).
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=articles
# Embedding backend: default (local ONNX all-MiniLM-L6-v2, no key) | openai
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=

# =====================================================================
# Scheduler (web admin background collection)
# =====================================================================
# Where scheduled connectors write: file | db | both
SCHEDULER_OUTPUT=both

# =====================================================================
# Enrichment pipeline (LLM article analyser + IOC enrichers)
# =====================================================================
ENRICHMENT_ENABLED=true
# Number of concurrent enrichment worker coroutines.
ENRICHMENT_WORKERS=2
# How often the scanner sweeps for new un-enriched rows (seconds).
ENRICHMENT_SCAN_SECONDS=60
# How long an idle worker waits between queue polls.
ENRICHMENT_POLL_SECONDS=5
# Retries before a job is marked 'error' (backoff: 1m, 5m, 30m).
ENRICHMENT_MAX_ATTEMPTS=3
# Cap how much article body is sent to the LLM (cost / latency control).
ENRICHMENT_LLM_CONTENT_MAX=8000

# IOC hash enrichment (ioc_basic enricher). Both optional — leave blank to skip.
# MalwareBazaar reuses ABUSECH_AUTH_KEY above (no separate key needed).
# VirusTotal needs a free API key from https://www.virustotal.com (Profile → API key).
VT_API_KEY=

# ---------------------------------------------------------------------
# LLM provider for enrichment: openai | gemini | ollama
# Default model per provider — used only as a first-boot seed for the
# ``llm_providers`` table. After that, edit the model in admin → LLM models.
# The single source of truth in code is DEFAULT_MODELS in src/llm/providers.py.
# ---------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
# OPENAI_API_KEY already declared in the storage section
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:3b
# Default OLLAMA_BASE_URL is http://localhost:11434; override here for Docker
# (the compose file sets http://host.docker.internal:11434 inside the app).
OLLAMA_BASE_URL=http://localhost:11434
